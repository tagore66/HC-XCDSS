# ==================================================
# HC-XCDSS Environment Configuration Reference (.env.example)
# ==================================================

# --------------------------------------------------
# Runtime Environment
# --------------------------------------------------
# Options: 'development' (default local) or 'production'
ENVIRONMENT=development
# Server port (Render and Cloud Run dynamically inject PORT)
PORT=8000

# --------------------------------------------------
# Database Configuration
# --------------------------------------------------
# Unset / absent = SQLite local file (outputs/hc_xcdss.db)
# PostgreSQL = postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# --------------------------------------------------
# Persistent Artifact Storage (Phase 3)
# --------------------------------------------------
# Options: 'local' (default, saves to outputs/) or 'cloudinary' (for cloud persistent storage)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------
# JWT Security & Authentication
# --------------------------------------------------
# Production deployments MUST use a secure random 64+ char secret string
JWT_SECRET_KEY=hc_xcdss_dev_insecure_secret_key_change_in_production_38472918
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------
# Networking & CORS
# --------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard in prod)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------------
# Platform Administrator Credentials (Auto-seeded on first run)
# --------------------------------------------------
ADMIN_EMAIL=admin@hcxcdss.org
ADMIN_PASSWORD=Admin#HCXCDSS2026!
ADMIN_NAME=Platform Administrator

# --------------------------------------------------
# Clinical AI Decision Support (LLM Assistant)
# --------------------------------------------------
# Options: 'mock' (offline deterministic rule-based assistant) or 'gemini' (live API)
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-3.7-flash

# --------------------------------------------------
# Payment Gateway Configuration
# --------------------------------------------------
# Options: 'mock' (instant test simulation) or 'stripe'
PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------
# Transactional Notification Email (SMTP)
# --------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@hcxcdss.org
SMTP_FROM_NAME=HC-XCDSS Platform
