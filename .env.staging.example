# ==================================================
# HC-XCDSS Staging Environment Configuration
# ==================================================

# Runtime Environment Mode ('development' or 'production')
ENVIRONMENT=production

# JWT Authentication Security (MUST be non-default in production)
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_staging
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Frontend Base URL (for email notification links and checkout redirects)
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Platform Administrator Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@hcxcdss.org
ADMIN_PASSWORD=replace_with_secure_staging_admin_password
ADMIN_NAME=Platform Administrator

# AI Clinical Assistant Provider ('mock' or 'gemini')
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-3.7-flash

# Payment Gateway Configuration ('mock' or 'stripe')
PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional SMTP Email Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@hcxcdss.org
SMTP_FROM_NAME=HC-XCDSS Platform
